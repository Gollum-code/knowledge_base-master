# ===================== 日志配置 =====================
# 控制台日志：True=开启/False=关闭，级别可选(DEBUG/INFO/WARNING/ERROR/CRITICAL)
LOG_CONSOLE_ENABLE=True
LOG_CONSOLE_LEVEL=DEBUG

# 文件日志：True=开启/False=关闭，级别与控制台可独立设置
LOG_FILE_ENABLE=True
LOG_FILE_LEVEL=INFO
# 日志文件保留天数（自动删除过期日志，避免磁盘占满）
LOG_FILE_RETENTION=7 days

# ===================== MinerU API =====================
# mineru api以及url处理地址！申请地址：https://mineru.net/
MINERU_API_TOKEN=请填入你的MinerU_API_Token
MINERU_BASE_URL=https://mineru.net/api/v4

# ===================== LLM & VLM =====================
# api_key申请地址：https://bailian.console.aliyun.com/cn-beijing/?spm=5176.29597918.J_SEsSjsNv72yRuRFS2VknO.2.4d877b08ThdGtP&tab=model#/api-key
# 大模型的文档地址：https://bailian.console.aliyun.com/cn-beijing/?spm=5176.29597918.J_SEsSjsNv72yRuRFS2VknO.2.4d877b08ThdGtP&tab=doc#/doc
# Qwen3系列Flash模型，实现思考模式和非思考模式的有效融合，可在对话中切换模式。复杂推理类任务性能优秀，指令遵循、文本理解等能力显著提高。支持1M上下文长度，按照上下文长度进行阶梯计费。
LLM_DEFAULT_MODEL=qwen-flash
#Qwen3系列小尺寸视觉理解模型，实现思考模式和非思考模式的有效融合，效果优于开源版Qwen3-VL-30B-A3B，响应速度快。全面升级图像/视频理解，支持长视频长文档等超长上下文、
#空间感知与万物识别；具备视觉2D/3D定位能力，胜任复杂现实任务。
VL_MODEL=qwen3-vl-flash
# api_key申请地址：https://bailian.console.aliyun.com/
OPENAI_API_KEY=sk-请填入你的百炼DashScope_API_Key
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#temperature = 控制大模型回答的 “随机度 / 创造力 / 稳定性”
#值越大 → 越随机、越发散、越有创意
#值越小 → 越确定、越保守、越贴近标准答案
LLM_DEFAULT_TEMPERATURE=0.1

# ===================== MinIO =====================
MINIO_ENDPOINT=192.168.121.128:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=knowledge-base-files
MINIO_IMG_DIR=/upload-images
MINIO_SECURE=False

# ===================== 向量模型 =====================
# BGE-M3模型本地缓存/部署路径（本地加载模型时使用，指向ModelScope下载的模型目录）
BGE_M3_PATH=D:/ai_models/modelscope_cache/models/Xorbits/bge-m3
# BGE-M3模型官方标识（ModelScope/HuggingFace通用，拉取模型时使用）
BGE_M3=BAAI/bge-m3
# BGE-M3运行设备，cuda:0表示使用第1块GPU，cpu表示使用CPU，cuda:N表示第N+1块GPU
BGE_DEVICE=cuda:0
# BGE-M3是否开启FP16半精度推理，1=开启（GPU加速更高效），0=关闭（兼容低版本GPU/CPU）
BGE_FP16=1

#MINERU
MINERU_MODEL_SOURCE=modelscope
MODELSCOPE_OFFLINE=1
MODELSCOPE_CACHE=D:/ai_models/modelscope_cache
HF_HOME=D:/ai_models/huggingface_cache
MD_ROOT_DIR=./temp-files/

# ===================== Milvus 配置 =====================
# 切换成你milvus的url地址
MILVUS_URL=http://192.168.121.128:19530
# 存储切片集合
CHUNKS_COLLECTION=kb_chunks
# 预留
ENTITY_NAME_COLLECTION=kb_graph_entity_names
# 存储每个文档对应的实体类
ITEM_NAME_COLLECTION=kb_item_names

EMBEDDING_DIM=1024
MILVUS_METRIC_TYPE=COSINE
MILVUS_MIN_COSINE_SCORE=0.75

# ===================== MongoDB 配置 =====================
MONGO_URL=mongodb://192.168.121.128:27017
MONGO_DB_NAME=kb

# ===================== MCP =====================
# 百炼 WebSearch MCP 服务地址（Streamable HTTP 协议）
MCP_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1/mcps/WebSearch/mcp

# ===================== 安全 / CORS（可选） =====================
# 配置后，/upload、/query、/status、/history 等接口需要携带 Bearer Token 才能访问
API_AUTH_TOKEN=
# 允许跨域的具体域名，多个用逗号分隔；留空表示允许所有来源（仅限内网演示）
CORS_ALLOWED_ORIGINS=
# 上传单文件大小上限（字节），默认 200MB
MAX_FILE_SIZE_BYTES=209715200

# ===================== 失败重试（可选） =====================
# 对 LLM / MinerU / MCP 等外部调用的瞬时错误（429/5xx/网络超时）做指数退避重试
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY=1
RETRY_MAX_DELAY=15
# LLM 单次请求超时（秒）与重试次数
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2

# ===================== 批量向量化 & TPU降级（可选） =====================
# BGE-M3 每批向量化文本数，按显卡显存调整（显存小调小，显存大调大）
BGE_BATCH_SIZE=5
# GPU 初始化失败时自动降级为 CPU+FP32（无法关闭，仅用于说明）

# ===================== 上下文配额（可选） =====================
# Prompt 参考内容总字符上限，以及文档/历史各自的占用比例（和为 1）
CONTEXT_MAX_CHARS=12000
CONTEXT_DOCS_RATIO=0.7
CONTEXT_HISTORY_RATIO=0.3

# ===================== 全链路追踪（可选） =====================
TRACE_ENABLED=True
# 节点耗时超过该毫秒数时打印 WARNING 慢调用日志
TRACE_SLOW_THRESHOLD_MS=500

# ===================== 可选 Redis 状态存储 =====================
# 配置后任务状态写入 Redis，支持多 worker / 重启后状态恢复；留空则使用进程内存
REDIS_URL=
# 任务状态保留时长（秒）；Redis 后端依赖其 TTL，内存后端懒触发清理
TASK_DATA_RETENTION_SECONDS=3600

# ===================== 检索阈值调参（可选） =====================
# 商品名称对齐阈值：高于高阈值直接确认，低阈值~高阈值列为候选追问
ITEM_CONFIRM_HIGH_SCORE=0.85
ITEM_CONFIRM_LOW_SCORE=0.6
# Milvus 检索最低余弦分（当前仅用于日志标注）
MILVUS_MIN_COSINE_SCORE=0.75

# ===================== MinIO 桶策略（可选） =====================
# 仅该前缀下的对象匿名只读（图片目录）；其余对象（PDF 等）需签名 URL
MINIO_PUBLIC_PREFIX=/upload-images

# ===================== 重排序模型配置 =====================
BGE_RERANKER_LARGE=D:\ai_models\modelscope_cache\models\rerank\BAAI\bge-reranker-large
BGE_RERANKER_DEVICE=cuda:0
BGE_RERANKER_FP16=1